MARKET_DB_PATH=/app/data/market.db
VORP_ARTIFACT_PATH=/app/data/vorp.json
TITULARIDADE_PATH=/app/data/titularidade.json
RUNTIME_DIR=/app/runtime
LOG_LEVEL=INFO
KERNEL_VORP_THETA=0.0
KERNEL_MAX_GOALS=12
# The Odds API (scripts/sombra.py --capture, scripts/odds_shop.py): o nome
# exigido pelo codigo e' ODDS_API_KEY, NAO THE_ODDS_API_KEY (Settings.THE_
# ODDS_API_KEY existe mas so' e' lido pelo relatorio de prontidao da H9 -
# TheOddsApiProvider, o caminho de captura de verdade, so' enxerga esta).
ODDS_API_KEY=
API_FOOTBALL_KEY=
SPORTMONKS_API_TOKEN=
EXCHANGE_WEBSOCKET_URL=
EXCHANGE_API_KEY=

# Captura prospectiva (scripts/sombra.py --capture): casa unica auditavel para
# preco do pick e fechamento ("ultimo valido pre-apito"). Sem isto, a captura
# fica bloqueada e fecha todo run com 0 picks novos (a coorte h3/h5 nunca
# comeca a contar). CONGELADO nas trials h3/h5/h7-*-pinnacle-2026 (registradas
# 2026-07-26, params.bookmaker) em: pinnacle. sombra.py agora recusa qualquer
# valor que divergir do registro da trial - nao adianta pedir outra casa aqui
# sem antes registrar trial nova.
# MUDANCA DE CONFIGURACAO, NAO DE CODIGO; trocar depois de congelado abre
# coorte nova (contagem do zero, arquivos separados) - nao trocar sem motivo.
BRASILEIRAO_BOOKMAKER=
