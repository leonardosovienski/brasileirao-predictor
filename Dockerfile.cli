FROM python:3.14.7-slim-bookworm AS builder
RUN pip install --no-cache-dir uv==0.12.1
WORKDIR /build
COPY pyproject.toml README.md ./
COPY constraints/shared-wheels.sha256 constraints/shared-wheels.sha256
COPY src src
COPY scripts scripts
RUN python -c "import urllib.request; urllib.request.urlretrieve('https://github.com/leonardosovienski/core-predictor/releases/download/v2.3.0/predictor_core-2.3.0-py3-none-any.whl', 'predictor_core-2.3.0-py3-none-any.whl'); urllib.request.urlretrieve('https://github.com/leonardosovienski/predictor-ops/releases/download/v3.1.0/predictor_ops-3.1.0-py3-none-any.whl', 'predictor_ops-3.1.0-py3-none-any.whl')" \
    && sha256sum -c constraints/shared-wheels.sha256 \
    && uv build && uv venv /opt/venv && uv pip install --python /opt/venv/bin/python \
    predictor_core-2.3.0-py3-none-any.whl predictor_ops-3.1.0-py3-none-any.whl \
    dist/*.whl

FROM python:3.14.7-slim-bookworm
RUN useradd --system --uid 10001 --create-home app
COPY --from=builder /opt/venv /opt/venv
USER 10001
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR /app
ENTRYPOINT ["brasileirao-predict"]
