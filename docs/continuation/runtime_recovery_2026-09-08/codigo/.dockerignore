# Only inputs consumed by the three Dockerfiles enter the build context.
**
!Dockerfile.worker
!Dockerfile.kernel
!Dockerfile.cli
!.dockerignore
!README.md
!pyproject.toml
!uv.lock
!constraints/
!constraints/shared-wheels.sha256
!brasileirao_predictor/
!brasileirao_predictor/**
!brasileirao_scripts/
!brasileirao_scripts/**
!dotnet/
!dotnet/LineupWorker/
!dotnet/LineupWorker/**
# Keep the synthetic Compose fixtures available; no operational data is copied.
!docker/
!docker/vorp.json
!docker/titularidade.json

# Also exclude generated files or secrets nested inside an allowed source tree.
**/.git
**/.env
**/.env.*
**/.venv
**/__pycache__
**/*.pyc
**/*.pyo
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.pem
**/*.key
**/bin
**/obj
**/TestResults*
