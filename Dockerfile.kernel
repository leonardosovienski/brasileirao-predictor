FROM python:3.14.7-slim-bookworm AS builder
RUN pip install --no-cache-dir uv==0.12.1
WORKDIR /build
COPY pyproject.toml uv.lock README.md STACK_WHEELS.json ./
COPY constraints/shared-wheels.sha256 constraints/shared-wheels.sha256
COPY tools/stack_wheels.py tools/stack_wheels.py
# Published core/ops wheels already fetched and sha256-verified into the build context by
# `tools/stack_wheels.py fetch` (the producers are private; the image never contacts GitHub).
COPY .stack-wheels .stack-wheels
COPY brasileirao_predictor brasileirao_predictor
COPY brasileirao_scripts brasileirao_scripts
RUN (cd .stack-wheels && sha256sum -c ../constraints/shared-wheels.sha256) \
    && python tools/stack_wheels.py check \
    && uv export --locked --no-dev --extra kernel --no-emit-project \
        --format requirements.txt --output-file requirements.lock \
    && python tools/stack_wheels.py requirements --input requirements.lock --output requirements.hashed.lock \
    && uv build --wheel && uv venv /opt/venv \
    && uv pip sync --python /opt/venv/bin/python --require-hashes requirements.hashed.lock \
    && uv pip install --python /opt/venv/bin/python --no-deps dist/*.whl

FROM python:3.14.7-slim-bookworm
RUN useradd --system --uid 10001 --create-home app
COPY --from=builder /opt/venv /opt/venv
USER 10001
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 NUMBA_CACHE_DIR=/tmp/numba
WORKDIR /app
ENTRYPOINT ["brasileirao-kernel"]
