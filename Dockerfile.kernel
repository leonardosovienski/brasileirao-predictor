FROM python:3.13.11-slim-bookworm AS builder
RUN pip install --no-cache-dir uv==0.12.1
WORKDIR /build
ARG PREDICTOR_CORE_WHEEL_URL
ARG PREDICTOR_OPS_WHEEL_URL
ADD ${PREDICTOR_CORE_WHEEL_URL} /wheelhouse/predictor_core-2.1.0-py3-none-any.whl
ADD ${PREDICTOR_OPS_WHEEL_URL} /wheelhouse/predictor_ops-2.0.1-py3-none-any.whl
COPY pyproject.toml README.md ./
COPY src src
COPY scripts scripts
RUN uv build && uv venv /opt/venv && uv pip install --python /opt/venv/bin/python \
    --find-links /wheelhouse 'dist/brasileirao_predictor-0.1.0-py3-none-any.whl[kernel]'

FROM python:3.13.11-slim-bookworm
RUN useradd --system --uid 10001 --create-home app
COPY --from=builder /opt/venv /opt/venv
USER 10001
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 NUMBA_CACHE_DIR=/tmp/numba
WORKDIR /app
ENTRYPOINT ["brasileirao-kernel"]
