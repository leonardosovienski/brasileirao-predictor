FROM python:3.13.11-slim-bookworm AS builder
RUN pip install --no-cache-dir uv==0.12.1
WORKDIR /build
COPY pyproject.toml README.md ./
COPY src src
COPY scripts scripts
RUN uv build && uv venv /opt/venv && uv pip install --python /opt/venv/bin/python \
    "predictor-core @ https://github.com/leonardosovienski/core-predictor/releases/download/v2.3.0/predictor_core-2.3.0-py3-none-any.whl" \
    "predictor-ops @ https://github.com/leonardosovienski/predictor-ops/releases/download/v3.1.0/predictor_ops-3.1.0-py3-none-any.whl" \
    'dist/brasileirao_predictor-0.1.0-py3-none-any.whl[kernel]'

FROM python:3.13.11-slim-bookworm
RUN useradd --system --uid 10001 --create-home app
COPY --from=builder /opt/venv /opt/venv
USER 10001
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 NUMBA_CACHE_DIR=/tmp/numba
WORKDIR /app
ENTRYPOINT ["brasileirao-kernel"]
