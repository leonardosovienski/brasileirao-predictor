FROM python:3.14.7-slim-bookworm AS builder
RUN pip install --no-cache-dir uv==0.12.1
WORKDIR /build
COPY pyproject.toml uv.lock README.md ./
COPY constraints/shared-wheels.sha256 constraints/shared-wheels.sha256
COPY brasileirao_predictor brasileirao_predictor
COPY brasileirao_scripts brasileirao_scripts
RUN python -c "import urllib.request; urllib.request.urlretrieve('https://github.com/leonardosovienski/core-predictor/releases/download/v3.1.0/predictor_core-3.1.0-py3-none-any.whl', 'predictor_core-3.1.0-py3-none-any.whl'); urllib.request.urlretrieve('https://github.com/leonardosovienski/predictor-ops/releases/download/v4.0.0/predictor_ops-4.0.0-py3-none-any.whl', 'predictor_ops-4.0.0-py3-none-any.whl')" \
    && sha256sum -c constraints/shared-wheels.sha256 \
    && uv export --locked --no-dev --extra kernel --no-emit-project \
        --format requirements.txt --output-file requirements.lock \
    && uv build --wheel && uv venv /opt/venv \
    && uv pip sync --python /opt/venv/bin/python --require-hashes requirements.lock \
    && uv pip install --python /opt/venv/bin/python --no-deps dist/*.whl

FROM python:3.14.7-slim-bookworm
RUN useradd --system --uid 10001 --create-home app
COPY --from=builder /opt/venv /opt/venv
USER 10001
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 NUMBA_CACHE_DIR=/tmp/numba
WORKDIR /app
ENTRYPOINT ["brasileirao-kernel"]
